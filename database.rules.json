{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name','code']) && newData.child('name').isString() && newData.child('name').val().length <= 20 && newData.child('code').isString() && newData.child('code').val().length === 6"
      }
    },
    "codes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "chats": {
      "$cid": {
        ".read": "auth != null && $cid.contains(auth.uid)",
        "$mid": {
          ".write": "auth != null && $cid.contains(auth.uid) && !data.exists() && newData.child('uid').val() === auth.uid",
          ".validate": "newData.hasChildren(['uid','text','ts']) && newData.child('text').isString() && newData.child('text').val().length <= 300"
        }
      }
    },
    "rooms": {
      "$lang": {
        ".read": "auth != null",
        "$mid": {
          ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
          ".validate": "newData.hasChildren(['uid','name','text','ts']) && newData.child('text').isString() && newData.child('text').val().length <= 200 && newData.child('name').isString() && newData.child('name').val().length <= 20"
        }
      }
    },
    "challenges": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$id": {
          ".write": "auth != null && !data.exists() && newData.child('from').val() === auth.uid",
          ".validate": "newData.hasChildren(['from','fromName','words','ts'])"
        }
      }
    },
    "results": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$id": {
          ".write": "auth != null && !data.exists() && newData.child('by').val() === auth.uid"
        }
      }
    },
    "progress": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['j','ts']) && newData.child('j').isString() && newData.child('j').val().length <= 3000000 && newData.child('ts').isNumber()"
      }
    },
    "reports": {
      "$id": {
        ".read": false,
        ".write": "auth != null && !data.exists()"
      }
    },
    "classes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('teacher').val() === auth.uid) || (data.exists() && data.child('teacher').val() === auth.uid))",
        ".validate": "$code.matches(/^[A-Z0-9]{6}$/) && newData.hasChildren(['name','teacher','lang']) && newData.child('teacher').val() === auth.uid && newData.child('name').isString() && newData.child('name').val().length <= 40 && newData.child('lang').isString() && newData.child('lang').val().length <= 3 && (!newData.child('tname').exists() || (newData.child('tname').isString() && newData.child('tname').val().length <= 30)) && (!newData.child('board').exists() || newData.child('board').isBoolean())"
      }
    },
    "members": {
      "$code": {
        ".read": "auth != null && root.child('classes/'+$code+'/teacher').val() === auth.uid",
        ".write": "auth != null && root.child('classes/'+$code+'/teacher').val() === auth.uid",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && (root.child('classes/'+$code).exists() || !newData.exists())",
          ".validate": "newData.hasChildren(['name','ts']) && newData.child('name').isString() && newData.child('name').val().length <= 30"
        }
      }
    },
    "tasks": {
      "$code": {
        ".read": "auth != null && (root.child('classes/'+$code+'/teacher').val() === auth.uid || root.child('members/'+$code+'/'+auth.uid).exists())",
        ".write": "auth != null && root.child('classes/'+$code+'/teacher').val() === auth.uid",
        "$tid": {
          ".validate": "newData.hasChildren(['k','n','ts']) && newData.child('k').isString() && newData.child('k').val().length <= 10 && newData.child('n').isNumber() && newData.child('n').val() >= 1 && newData.child('n').val() <= 10000 && (!newData.child('t').exists() || (newData.child('t').isString() && newData.child('t').val().length <= 60))"
        }
      }
    },
    "cstats": {
      "$code": {
        ".read": "auth != null && root.child('classes/'+$code+'/teacher').val() === auth.uid",
        ".write": "auth != null && root.child('classes/'+$code+'/teacher').val() === auth.uid",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && (root.child('members/'+$code+'/'+auth.uid).exists() || !newData.exists())",
          ".validate": "newData.hasChildren(['name','ts']) && newData.child('name').isString() && newData.child('name').val().length <= 30"
        }
      }
    },
    "mycls": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$code": {
          ".validate": "newData.val() === 't' || newData.val() === 's'"
        }
      }
    },
    "wlists": {
      "$code": {
        ".read": "auth != null && (root.child('classes/'+$code+'/teacher').val() === auth.uid || root.child('members/'+$code+'/'+auth.uid).exists())",
        ".write": "auth != null && root.child('classes/'+$code+'/teacher').val() === auth.uid",
        "$lid": {
          ".validate": "newData.hasChildren(['name','w','ts']) && newData.child('name').isString() && newData.child('name').val().length <= 40 && newData.child('w').isString() && newData.child('w').val().length <= 45000"
        }
      }
    },
    "board": {
      "$code": {
        ".read": "auth != null && (root.child('classes/'+$code+'/teacher').val() === auth.uid || (root.child('classes/'+$code+'/board').val() === true && root.child('members/'+$code+'/'+auth.uid).exists()))",
        ".write": "auth != null && root.child('classes/'+$code+'/teacher').val() === auth.uid",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (root.child('members/'+$code+'/'+auth.uid).exists() || !newData.exists())",
          ".validate": "newData.hasChildren(['name','wxp','wk']) && newData.child('name').isString() && newData.child('name').val().length <= 30 && newData.child('wxp').isNumber() && newData.child('wk').isString() && newData.child('wk').val().length <= 12"
        }
      }
    }
  }
}
